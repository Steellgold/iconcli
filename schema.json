{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Configuration version"
    },
    "baseDir": {
      "type": "string",
      "description": "Base directory where icons folder will be created (relative to project root)"
    },
    "iconsFolder": {
      "type": "string",
      "description": "Name of the icons subfolder",
      "default": "icons"
    },
    "framework": {
      "type": "string",
      "enum": ["react", "vue", "svelte"],
      "description": "Target framework for component generation"
    },
    "typescript": {
      "type": "boolean",
      "description": "Generate TypeScript components",
      "default": true
    },
    "optimize": {
      "type": "boolean",
      "description": "Automatically optimize SVG with SVGO",
      "default": true
    },
    "maintainIndex": {
      "type": "boolean",
      "description": "Automatically maintain an index file with all icon exports",
      "default": true
    },
    "props": {
      "type": "object",
      "properties": {
        "size": {
          "type": "boolean",
          "description": "Include size prop",
          "default": true
        },
        "color": {
          "type": "boolean",
          "description": "Include color prop",
          "default": true
        },
        "className": {
          "type": "boolean",
          "description": "Include className prop",
          "default": true
        },
        "style": {
          "type": "boolean",
          "description": "Include style prop",
          "default": false
        }
      }
    },
    "naming": {
      "type": "object",
      "properties": {
        "suffix": {
          "type": "string",
          "description": "Suffix to add to icon names",
          "default": "Icon"
        },
        "suffixEnabled": {
          "type": "boolean",
          "description": "Whether to add suffix to icon names",
          "default": true
        },
        "componentCase": {
          "type": "string",
          "enum": ["PascalCase", "camelCase"],
          "description": "Case format for component names (internal)",
          "default": "PascalCase"
        },
        "fileCase": {
          "type": "string",
          "enum": ["PascalCase", "kebab-case", "camelCase"],
          "description": "Case format for file names",
          "default": "PascalCase"
        }
      }
    },
    "svgo": {
      "type": "object",
      "description": "SVGO optimization plugins configuration"
    },
    "adaptToProject": {
      "type": "boolean",
      "description": "Automatically detect and apply project's ESLint/Prettier formatting rules",
      "default": true
    }
  },
  "required": ["baseDir", "framework"]
}
