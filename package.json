{
  "name": "@steellgold/mkicon",
  "version": "0.6.0",
  "description": "Transform SVG icons into beautiful React, Vue, or Svelte components with zero config",
  "keywords": [
    "icon",
    "svg",
    "react",
    "react-native",
    "vue",
    "svelte",
    "component",
    "cli",
    "generator",
    "typescript",
    "spinner",
    "batch",
    "diff"
  ],
  "author": "Gaëtan H",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Steellgold/mkicon.git"
  },
  "bugs": {
    "url": "https://github.com/Steellgold/mkicon/issues"
  },
  "homepage": "https://github.com/Steellgold/mkicon#readme",
  "bin": {
    "mkicon": "./bin/cli.js"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./schema.json": "./schema.json"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "bin",
    "schema.json",
    "README.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build:cli": "tsup && tsc-alias",
    "build:studio": "cd studio-app && pnpm install --frozen-lockfile && pnpm build",
    "build": "pnpm build:cli && pnpm build:studio",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@resvg/resvg-js": "^2.6.2",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "cosmiconfig": "^9.0.1",
    "enquirer": "^2.4.1",
    "openai": "^6.32.0",
    "ora": "^9.3.0",
    "svgo": "^4.0.1",
    "terminal-image": "^4.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.8.1",
    "tsc-alias": "^1.8.16",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
