{
  "name": "mkicon",
  "version": "0.1.0",
  "description": "Transform SVG icons into beautiful React, Vue, or Svelte components with zero config",
  "keywords": [
    "icon",
    "svg",
    "react",
    "vue",
    "svelte",
    "component",
    "cli",
    "generator",
    "typescript"
  ],
  "author": "Gaëtan H",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Steellgold/mkicon.git"
  },
  "bugs": {
    "url": "https://github.com/Steellgold/mkicon/issues"
  },
  "homepage": "https://github.com/Steellgold/mkicon#readme",
  "bin": {
    "mkicon": "./bin/cli.js"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./schema.json": "./schema.json"
  },
  "files": [
    "dist",
    "bin",
    "schema.json",
    "README.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "enquirer": "^2.4.1",
    "commander": "^12.0.0",
    "svgo": "^3.2.0",
    "axios": "^1.6.7",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "cosmiconfig": "^9.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "typescript": "^5.3.3",
    "tsup": "^8.0.2",
    "vitest": "^1.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
