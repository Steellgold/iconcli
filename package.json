{
  "name": "@steellgold/mkicon",
  "version": "0.1.1",
  "description": "Transform SVG icons into beautiful React, Vue, or Svelte components with zero config",
  "keywords": [
    "icon",
    "svg",
    "react",
    "vue",
    "svelte",
    "component",
    "cli",
    "generator",
    "typescript"
  ],
  "author": "Gaëtan H",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Steellgold/mkicon.git"
  },
  "bugs": {
    "url": "https://github.com/Steellgold/mkicon/issues"
  },
  "homepage": "https://github.com/Steellgold/mkicon#readme",
  "bin": {
    "mkicon": "./bin/cli.js"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./schema.json": "./schema.json"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "bin",
    "schema.json",
    "README.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && tsc-alias",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "cosmiconfig": "^9.0.1",
    "enquirer": "^2.4.1",
    "ora": "^9.3.0",
    "svgo": "^4.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsc-alias": "^1.8.16",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
